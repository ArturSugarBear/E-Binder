{
  "name": "e-binder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "predev": "node scripts/generate-pwa-icons.mjs",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/generate-pwa-icons.mjs",
    "build": "npm run validate:data && tsc --noEmit && vite build",
    "postbuild": "node scripts/validate-pwa.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:data": "node --import tsx scripts/validate-data.ts",
    "test": "vitest run && node --test tests/roboflow-card-import.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run test && npm run build",
    "audit:artwork": "node scripts/audit-catalog-art.mjs",
    "audit:providers": "node --import tsx scripts/audit-p0-providers.ts",
    "audit:card-images": "node scripts/audit-catalog-card-coverage.mjs",
    "audit:beta-model": "node scripts/compare-beta-benchmarks.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "motion": "14.12.0",
    "onnxruntime-web": "1.31.1",
    "simple-liquid-glass": "5.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0"
  }
}
