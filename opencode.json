{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--headless",
          "--isolated",
          "--block-service-workers",
          "--browser",
          "chromium",
          "--viewport-size",
          "1440x900",
          "--output-dir",
          "test-results/visual-review/desktop",
          "--snapshot-boxes",
          "--caps",
          "vision,devtools"
        ],
        "timeout": {
          "startup": 120000
        }
      },
      "playwright-mobile": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--headless",
          "--isolated",
          "--block-service-workers",
          "--browser",
          "chromium",
          "--device",
          "iPhone 13",
          "--output-dir",
          "test-results/visual-review/mobile",
          "--snapshot-boxes",
          "--caps",
          "vision,devtools"
        ],
        "timeout": {
          "startup": 120000
        }
      },
      "context7": {
        "type": "local",
        "command": ["npx", "-y", "@upstash/context7-mcp"],
        "timeout": {
          "startup": 120000
        }
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--headless",
          "--isolated",
          "--executablePath",
          "/home/codespace/.cache/ms-playwright/chromium-1254/chrome-linux64/chrome",
          "--viewport",
          "1440x900",
          "--workspace",
          "/workspaces/E-Binder",
          "--chrome-arg=--no-sandbox",
          "--chrome-arg=--disable-dev-shm-usage",
          "--no-usage-statistics",
          "--no-performance-crux",
          "--no-category-memory",
          "--screenshotFormat",
          "webp",
          "--screenshotQuality",
          "80",
          "--screenshotMaxWidth",
          "1200"
        ],
        "timeout": {
          "startup": 120000
        }
      }
    }
  }
}
